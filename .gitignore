# Secrets — never commit
.env
.env.*
!.env.example
**/secrets/**
**/gcp-oauth.keys.json
**/.gmail-mcp/**
**/google-calendar-mcp/**
**/mcp-auth.json
*.key
*.pem
*secret*.json

# Python / venv
__pycache__/
.venv/
.venv-*/
*.pyc
*.pyo

# Voice models (large, downloaded locally)
ai-assistant/models/
*.onnx
*.onnx.json
*.part

# Temp / misc
tmp/
*.tmp
.DS_Store

# Archives — freeze (see OPERATIONS_REGISTRY.md)
# Duplicate archives are archived under archive/ and never re-downloaded.
*.zip
*.tar.gz
*.tgz
*.tar
*.rar
*.7z
archive/*.zip
archive/*.tar.gz
archive/*.tgz
archive/*.tar
