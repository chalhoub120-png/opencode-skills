# Secrets — never commit
.env
.env.*
!.env.example
**/secrets/**
**/gcp-oauth.keys.json
**/.gmail-mcp/**
**/google-calendar-mcp/**
**/mcp-auth.json
*.key
*.pem
*secret*.json

# Python / venv
__pycache__/
.venv/
.venv-*/
*.pyc
*.pyo

# Voice models (large, downloaded locally)
ai-assistant/models/
*.onnx
*.onnx.json
*.part

# Temp / misc
tmp/
*.tmp
.DS_Store

# Node.js dependencies
node_modules/

# Archives — freeze (see OPERATIONS_REGISTRY.md)
# Duplicate archives are archived under archive/ and never re-downloaded.
archive/
*.zip
*.tar.gz
*.tgz
*.tar
*.rar
*.7z

# Backup files — never commit
*.bak
*.backup
*.orig
*.rej

# Log files — never commit
*.log

# Database dumps — never commit
*.dump
*.db
*.sqlite
*.sqlite3

# Audio outputs — never commit
*.wav
*.mp3
*.ogg

# Embedded / external skill repos — managed separately
.vendor-skills/
_vendor-skills/
_staging/
artemis-review/
claude-skills-src/
my-scraper-clone/
open-code-skills-manager/
security/
