    async def get_document_changes_since(
        self,
        since: str,
    ) -> List[Dict[str, Any]]:
        async with self._acquire() as conn:
            rows = await conn.fetch(
                """
                SELECT dcl.id, dcl.document_id, dcl.change_type,
                       dcl.old_content_hash, dcl.new_content_hash,
                       dcl.changed_at, d.filename, d.access_level
                FROM document_change_log dcl
                JOIN documents d ON d.id = dcl.document_id
                WHERE dcl.changed_at > $1
                ORDER BY dcl.changed_at DESC
                """,
                since,
            )
        return [dict(r) for r in rows]

    # ------------------------------------------------------------------
    # Approval requests (human-in-the-loop for external actions)
    # ------------------------------------------------------------------
    async def create_approval_request(
        self,
        user_id: str,
        action_type: str,
        target_resource: Optional[str] = None,
        parameters: Optional[Dict[str, Any]] = None,
        workflow_id: Optional[str] = None,
    ) -> Dict[str, Any]:
        async with self._acquire() as conn:
            row = await conn.fetchrow(
                """
                INSERT INTO approval_requests
                (user_id, workflow_id, action_type, target_resource, parameters)
                VALUES ($1, $2, $3, $4, $5)
                RETURNING id, status, requested_at
                """,
                user_id,
                workflow_id,
                action_type,
                target_resource,
                parameters,
            )
        return dict(row)

    async def get_approval_request(self, request_id: str) -> Optional[Dict[str, Any]]:
        async with self._acquire() as conn:
            row = await conn.fetchrow(
                """
                SELECT id, user_id, workflow_id, action_type, target_resource,
                       parameters, status, requested_at, decided_at, decided_by, decision_reason
                FROM approval_requests WHERE id = $1
                """,
                request_id,
            )
        return dict(row) if row else None

    async def decide_approval_request(
        self,
        request_id: str,
        decision: str,
        decided_by: str,
        reason: Optional[str] = None,
    ) -> bool:
        """decision: 'approved' or 'rejected'"""
        if decision not in ("approved", "rejected"):
            return False
        async with self._acquire() as conn:
            result = await conn.execute(
                """
                UPDATE approval_requests
                SET status = $2, decided_at = NOW(), decided_by = $3,
                    decision_reason = $4
                WHERE id = $1 AND status = 'pending'
                """,
                request_id,
                decision,
                decided_by,
                reason,
            )
        return result == "UPDATE 1"

    async def get_pending_approvals(
        self, user_id: Optional[str] = None
    ) -> List[Dict[str, Any]]:
        async with self._acquire() as conn:
            if user_id:
                rows = await conn.fetch(
                    """
                    SELECT id, user_id, workflow_id, action_type, target_resource,
                           parameters, status, requested_at
                    FROM approval_requests
                    WHERE user_id = $1 AND status = 'pending'
                    ORDER BY requested_at DESC
                    """,
                    user_id,
                )
            else:
                rows = await conn.fetch(
                    """
                    SELECT id, user_id, workflow_id, action_type, target_resource,
                           parameters, status, requested_at
                    FROM approval_requests
                    WHERE status = 'pending'
                    ORDER BY requested_at DESC
                    """,
                )
        return [dict(r) for r in rows]
