"""Database access layer for PostgreSQL using asyncpg.

Provides typed access to all tables defined in schema.sql:
users, agents, projects, conversations, messages, memories, tasks, documents, audit_logs.
"""

from __future__ import annotations

import logging
import json
import os
from uuid import UUID
from contextlib import asynccontextmanager
from dataclasses import dataclass
from datetime import datetime, timezone
from typing import Any, Dict, List, Optional

try:
    import asyncpg  # type: ignore
except ImportError as exc:  # pragma: no cover - dependency check
    raise RuntimeError("asyncpg is required for database access") from exc

logger = logging.getLogger(__name__)


@dataclass
class UserRow:
    id: str
    username: str
    email: str
    role: str
    language_preference: str
    is_active: bool
    created_at: datetime


@dataclass
class ConversationRow:
    id: str
    user_id: str
    project_id: Optional[str]
    title: Optional[str]
    language: str
    created_at: datetime


@dataclass
class MessageRow:
    id: str
    conversation_id: str
    role: str
    content: str
    language: Optional[str]
    agent_id: Optional[str]
    created_at: datetime


@dataclass
class MemoryRow:
    id: str
    user_id: str
    content: str
    memory_type: str
    metadata: Dict[str, Any]
    created_at: datetime


class DatabaseManager:
    """Async PostgreSQL manager for the AI Assistant."""

    def __init__(self, database_url: Optional[str] = None) -> None:
        self.database_url = database_url or os.getenv(
            "DATABASE_URL", "postgresql+asyncpg://ai:ai123@localhost:5432/ai"
        )
        # asyncpg uses postgresql:// not postgresql+asyncpg://
        self._asyncpg_url = self.database_url.replace(
            "postgresql+asyncpg://", "postgresql://"
        )
        self._pool: Optional[asyncpg.Pool] = None

    async def connect(self) -> None:
        if self._pool is None:
            self._pool = await asyncpg.create_pool(
                self._asyncpg_url,
                min_size=2,
                max_size=10,
            )
            logger.info("Database pool connected")

    async def close(self) -> None:
        if self._pool is not None:
            await self._pool.close()
            self._pool = None

    @asynccontextmanager
    async def _acquire(self):
        if self._pool is None:
            await self.connect()
        assert self._pool is not None
        async with self._pool.acquire() as conn:
            yield conn

    # ------------------------------------------------------------------
    # Users
    # ------------------------------------------------------------------
    async def create_user(
        self,
        username: str,
        email: str,
        password_hash: str,
        role: str = "user",
        language_preference: str = "ar",
        api_key: Optional[str] = None,
    ) -> UserRow:
        async with self._acquire() as conn:
            row = await conn.fetchrow(
                """
                INSERT INTO users (username, email, password_hash, role, language_preference, api_key)
                VALUES ($1, $2, $3, $4, $5, $6)
                RETURNING id, username, email, role, language_preference, is_active, created_at
                """,
                username,
                email,
                password_hash,
                role,
                language_preference,
                api_key,
            )
        return UserRow(
            id=str(row["id"]),
            username=row["username"],
            email=row["email"],
            role=row["role"],
            language_preference=row["language_preference"],
            is_active=row["is_active"],
            created_at=row["created_at"],
        )

    async def get_user(self, user_id: str) -> Optional[Dict[str, Any]]:
        async with self._acquire() as conn:
            row = await conn.fetchrow(
                "SELECT id, username, email, role, language_preference, is_active FROM users WHERE id = $1",
                user_id,
            )
        if not row:
            return None
        return dict(row)

    async def get_user_by_api_key(self, api_key: str) -> Optional[Dict[str, Any]]:
        async with self._acquire() as conn:
            row = await conn.fetchrow(
                "SELECT id, username, email, role, language_preference, is_active FROM users WHERE api_key = $1",
                api_key,
            )
        if not row:
            return None
        return dict(row)

    # ------------------------------------------------------------------
    # Conversations
    # ------------------------------------------------------------------
    async def create_conversation(
        self,
        user_id: str,
        project_id: Optional[str] = None,
        title: Optional[str] = None,
        language: str = "ar",
    ) -> ConversationRow:
        async with self._acquire() as conn:
            row = await conn.fetchrow(
                """
                INSERT INTO conversations (user_id, project_id, title, language)
                VALUES ($1, $2, $3, $4)
                RETURNING id, user_id, project_id, title, language, created_at
                """,
                user_id,
                project_id,
                title,
                language,
            )
        return ConversationRow(
            id=str(row["id"]),
            user_id=str(row["user_id"]),
            project_id=str(row["project_id"]) if row["project_id"] else None,
            title=row["title"],
            language=row["language"],
            created_at=row["created_at"],
        )

    async def ensure_conversation(
        self,
        conversation_id: str,
        user_id: str,
        project_id: Optional[str] = None,
        language: str = "ar",
    ) -> None:
        """Ensure conversation row exists (for IDs generated by /chat)."""
        try:
            UUID(conversation_id)
        except (ValueError, TypeError, AttributeError):
            return
        async with self._acquire() as conn:
            await conn.execute(
                """
                INSERT INTO conversations (id, user_id, project_id, title, language)
                VALUES ($1, $2, $3, $4, $5)
                ON CONFLICT (id) DO NOTHING
                """,
                conversation_id,
                user_id,
                project_id,
                None,
                language or "ar",
            )

    async def create_conversation_message(
        self,
        conversation_id: Optional[str],
        user_id: str,
        project_id: Optional[str] = None,
        role: str = "user",
        content: str = "",
        language: Optional[str] = None,
        agent_id: Optional[str] = None,
    ) -> Dict[str, Any]:
        """Create a conversation (if needed) and a message within it."""
        if conversation_id is None:
            conv = await self.create_conversation(
                user_id=user_id, project_id=project_id, language=language or "ar"
            )
            conversation_id = conv.id
        else:
            await self.ensure_conversation(
                conversation_id=conversation_id,
                user_id=user_id,
                project_id=project_id,
                language=language or "ar",
            )
        row = await self.create_message(
            conversation_id=conversation_id,
            user_id=user_id,
            project_id=project_id,
            role=role,
            content=content,
            language=language,
            agent_id=agent_id,
        )
        return {
            "id": row.id,
            "conversation_id": conversation_id,
            "role": row.role,
            "content": row.content,
            "language": row.language,
            "agent_id": row.agent_id,
            "created_at": row.created_at,
        }

    async def get_conversation(self, conversation_id: str) -> Optional[Dict[str, Any]]:
        async with self._acquire() as conn:
            row = await conn.fetchrow(
                "SELECT id, user_id, project_id, title, language FROM conversations WHERE id = $1",
                conversation_id,
            )
        if not row:
            return None
        return dict(row)

    # ------------------------------------------------------------------
    # Messages
    # ------------------------------------------------------------------
    async def create_message(
        self,
        conversation_id: str,
        user_id: str,
        project_id: Optional[str],
        role: str,
        content: str,
        language: Optional[str] = None,
        agent_id: Optional[str] = None,
        tool_calls: Optional[Dict[str, Any]] = None,
        metadata: Optional[Dict[str, Any]] = None,
    ) -> MessageRow:
        async with self._acquire() as conn:
            # Validate agent_id is a UUID; if not, store as None (FK constraint)
            agent_uuid = None
            if agent_id is not None:
                try:
                    agent_uuid = UUID(agent_id)
                except (ValueError, AttributeError):
                    agent_uuid = None
            row = await conn.fetchrow(
                """
                INSERT INTO messages (conversation_id, role, content, language, agent_id, tool_calls, metadata)
                VALUES ($1, $2, $3, $4, $5, $6, $7)
                RETURNING id, conversation_id, role, content, language, agent_id, created_at
                """,
                conversation_id,
                role,
                content,
                language,
                agent_uuid,
                tool_calls,
                metadata,
            )
        # Store a short-term memory reference for assistant messages
        if role == "assistant":
            await self._store_message_memory(
                user_id=user_id,
                conversation_id=conversation_id,
                content=content,
                agent_id=agent_id,
            )
        return MessageRow(
            id=str(row["id"]),
            conversation_id=str(row["conversation_id"]),
            role=row["role"],
            content=row["content"],
            language=row["language"],
            agent_id=str(row["agent_id"]) if row["agent_id"] else None,
            created_at=row["created_at"],
        )

    async def _store_message_memory(
        self,
        user_id: str,
        conversation_id: str,
        content: str,
        agent_id: Optional[str],
    ) -> None:
        try:
            async with self._acquire() as conn:
                await conn.execute(
                    """
                    INSERT INTO memories (user_id, conversation_id, content, memory_type, metadata)
                    VALUES ($1, $2, $3, $4, $5)
                    """,
                    user_id,
                    conversation_id,
                    content,
                    "conversation_summary",
                    json.dumps({"agent_id": agent_id}) if agent_id else None,
                )
        except Exception as exc:  # pragma: no cover - best effort
            logger.warning("Failed to store message memory: %s", exc)

    async def get_conversation_messages(
        self,
        conversation_id: str,
        limit: int = 20,
    ) -> List[Dict[str, Any]]:
        try:
            UUID(conversation_id)
        except (ValueError, TypeError, AttributeError):
            return None
        async with self._acquire() as conn:
            rows = await conn.fetch(
                """
                SELECT id, role, content, language, agent_id, created_at
                FROM messages
                WHERE conversation_id = $1
                ORDER BY created_at DESC
                LIMIT $2
                """,
                conversation_id,
                limit,
            )
        return [dict(r) for r in rows]

