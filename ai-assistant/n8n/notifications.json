      "webhookId": "notify-webhook-ai"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\nconst out = [];\nfor (const item of $input.all()) {\n  const body = item.json.body ?? item.json;\n  const userId = body.user_id;\n  const message = body.message;\n  if (typeof userId !== 'string' || !UUID_RE.test(userId)) {\n    throw new Error('user_id must be a UUID');\n  }\n  if (typeof message !== 'string' || message.trim() === '') {\n    throw new Error('message must be a non-empty string');\n  }\n  out.push({\n    json: {\n      user_id: userId,\n      message: message.trim(),\n      type: typeof body.type === 'string' ? body.type : 'info',\n      channel: typeof body.channel === 'string' ? body.channel : 'in_app',\n      received_at: new Date().toISOString()\n    }\n  });\n}\nreturn out;"
      },
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "Validate Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [280, 0]
    },
