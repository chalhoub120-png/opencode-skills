    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\nconst out = [];\nfor (const item of $input.all()) {\n  const body = item.json.body ?? item.json;\n  const userId = body.user_id;\n  const message = body.message;\n  if (typeof userId !== 'string' || !UUID_RE.test(userId)) {\n    out.push({ json: { status: 'invalid', error: 'user_id must be a UUID' } });\n    continue;\n  }\n  if (typeof message !== 'string' || message.trim() === '') {\n    out.push({ json: { status: 'invalid', error: 'message must be a non-empty string' } });\n    continue;\n  }\n  const type = typeof body.type === 'string' && body.type.trim() !== '' ? body.type.trim() : 'info';\n  const channel = typeof body.channel === 'string' && body.channel.trim() !== '' ? body.channel.trim() : 'in_app';\n  if (type.length > 32) {\n    out.push({ json: { status: 'invalid', error: 'type must be 32 characters or fewer' } });\n    continue;\n  }\n  if (channel.length > 32) {\n    out.push({ json: { status: 'invalid', error: 'channel must be 32 characters or fewer' } });\n    continue;\n  }\n  out.push({ json: { status: 'ok', user_id: userId, message: message.trim(), type, channel } });\n}\nreturn out;"
      },
