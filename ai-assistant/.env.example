# ============================================================================
# Enterprise AI Assistant - Environment Variables
# Copy this file to .env and adjust values for production.
# ============================================================================

# --- Ollama LLM ---
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_HOST=ollama
OLLAMA_PORT=11434

# Model routing
CODING_MODEL=qwen3:32b
REASONING_MODEL=deepseek-r1:32b
GENERAL_MODEL=qwen3:32b

# --- Dify ---
DIFY_BASE_URL=http://dify:5001
DIFY_API_KEY=your-dify-api-key
DIFY_SECRET_KEY=change-this-key-in-production

# --- n8n ---
N8N_BASE_URL=http://n8n:5678
N8N_API_KEY=your-n8n-api-key
N8N_ENCRYPTION_KEY=change-this-key-in-production
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-this-password-in-production

# --- PostgreSQL ---
POSTGRES_USER=ai
POSTGRES_PASSWORD=change-this-password-in-production
POSTGRES_DB=ai
DATABASE_URL=postgresql+asyncpg://ai:change-this-password-in-production@postgres:5432/ai

# --- Redis ---
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# --- Qdrant ---
QDRANT_URL=http://qdrant:6333
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# --- OpenCode Orchestrator ---
API_SECRET_KEY=change-this-key-in-production
ORCHESTRATOR_PORT=8000
ORCHESTRATOR_HOST=0.0.0.0
DEFAULT_LLM_MODEL=qwen3:32b
REASONING_LLM_MODEL=deepseek-r1:32b

# --- Voice (STT/TTS) ---
WHISPER_MODEL=faster-whisper-large-v3
WHISPER_FALLBACK_MODEL=whisper-large-v3
WHISPER_LANGUAGE=auto
VAD_AGGRESSIVENESS=2
NOISE_SUPPRESSION=true
SILENCE_THRESHOLD=0.02
SILENCE_DURATION_MS=700

TTS_ENGINE=kokoro
TTS_VOICE_ARABIC_FEMALE=ar_female_01
TTS_VOICE_ARABIC_MALE=ar_male_01
TTS_VOICE_ENGLISH_FEMALE=en_female_01
TTS_VOICE_ENGLISH_MALE=en_male_01
TTS_STREAMING=true
TTS_INTERRUPTIBLE=true

# --- Security ---
API_KEY_HEADER=X-API-Key
JWT_SECRET_KEY=change-this-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
RBAC_ENABLED=true
AUDIT_LOG_ENABLED=true
AUDIT_LOG_TABLE=audit_logs

# --- Knowledge Base (RAG) ---
EMBEDDING_MODEL=bge-m3
RAG_TOP_K=5
RAG_HYBRID_ALPHA=0.7
RAG_RERANKING=true
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64

# --- Languages ---
SUPPORTED_LANGUAGES=ar,en
DEFAULT_LANGUAGE=ar
LEBANESE_DIALECT_ENABLED=true

# ============================================================================
# End of .env.example
# ============================================================================


