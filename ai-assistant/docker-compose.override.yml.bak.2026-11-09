services:
  # Ollama - placeholder (LLM runs natively on 11434, internal only)
  ollama:
    image: busybox:latest
    command: sleep infinity
    ports:
      - "127.0.0.1:11435:11434"
    networks:
      - ai-network

  postgres:
    image: postgres:16
    environment:
      POSTGRES_USER: ai
      POSTGRES_PASSWORD: ai123
      POSTGRES_DB: ai
    volumes:
      - postgres:/var/lib/postgresql/data
      - ./db/schema.sql:/docker-entrypoint-initdb.d/01-schema.sql
    networks:
      - ai-network

  redis:
    image: redis:7-alpine
    command: ["redis-server", "--appendonly", "yes"]
    networks:
      - ai-network

  qdrant:
    image: qdrant/qdrant:latest
    networks:
      - ai-network

  n8n:
    image: n8nio/n8n:latest
    environment:
      N8N_HOST: n8n
      N8N_PORT: 5678
      N8N_PROTOCOL: http
      N8N_BASIC_AUTH_ACTIVE: "true"
      N8N_BASIC_AUTH_USER: ${N8N_BASIC_AUTH_USER:-admin}
      N8N_BASIC_AUTH_PASSWORD: ${N8N_BASIC_AUTH_PASSWORD}
    networks:
      - ai-network

  dify:
    image: langgenius/dify-api:1.19.0
    environment:
      DATABASE_URL: postgresql://ai:ai123@postgres:5432/ai
      REDIS_URL: redis://redis:6379/0
      QDRANT_HOST: qdrant
      QDRANT_PORT: 6333
      SECRET_KEY: ${DIFY_SECRET_KEY}
    networks:
      - ai-network

  # opencode-orchestrator: no override - uses Dockerfile build from docker-compose.yml
