FROM python:3.12-slim

WORKDIR /app

# System dependencies (voice: ffmpeg/libsndfile - skip build step if network is slow; text/chat does not need them)
# To re-enable voice deps in Docker, uncomment the next line when network is stable:
# ffmpeg needs stable network (apt) - faster-whisper bundles its own av, skip apt for now

# Python dependencies (split into small steps: on flaky network a failed step retries without losing prior layers)
COPY requirements.txt .
RUN --mount=type=cache,target=/root/.cache/pip pip install --retries 10 --timeout 300 fastapi==0.162.0 uvicorn==0.54.0 httpx==0.28.1 asyncpg==0.32.0 pydantic==2.14.3 pydantic-settings==2.16.2
RUN --mount=type=cache,target=/root/.cache/pip pip install --retries 10 --timeout 300 python-jose[cryptography]==3.5.0 python-multipart==0.0.33 certifi==2026.10.23 pyjwt==2.15.1 websockets==17.4 jinja2==3.1.6
RUN --mount=type=cache,target=/root/.cache/pip pip install --retries 10 --timeout 300 qdrant-client==1.20.0 openpyxl==3.1.5 python-docx==1.2.0 pypdf==6.21.4 python-pptx==1.0.2
RUN --mount=type=cache,target=/root/.cache/pip pip install --retries 10 --timeout 300 faster-whisper>=1.0.0 ctranslate2 httpx[http2]

# Application code
COPY orchestrator /app/orchestrator
COPY agents /app/agents
COPY llm /app/llm
COPY knowledge /app/knowledge
COPY db /app/db
COPY tools /app/tools
COPY security /app/security
COPY voice /app/voice
COPY api /app/api
COPY scripts /app/scripts
COPY dashboard /app/dashboard

EXPOSE 8000

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
