import urllib.request, json

BASE_URL = "http://127.0.0.1:8001"
API_KEY = "demo-key-001"

def test_endpoint(method, path, data=None):
    url = BASE_URL + path
    headers_dict = {"Content-Type": "application/json", "X-API-Key": API_KEY}
    
    try:
        if method == "GET":
            req = urllib.request.Request(url, headers=headers_dict, method="GET")
        elif method == "POST":
            body = json.dumps(data).encode('utf-8') if data else None
            req = urllib.request.Request(url, data=body, headers=headers_dict, method="POST")
        
        with urllib.request.urlopen(req, timeout=30) as resp:
            body = resp.read().decode('utf-8')
            try:
                result = json.loads(body)
            except:
                result = body
            return {"status": resp.status, "success": True, "data": result}
    except urllib.error.HTTPError as e:
        body = e.read().decode('utf-8')
        try:
            result = json.loads(body)
        except:
            result = body
        return {"status": e.code, "success": False, "data": result}
    except Exception as e:
        return {"status": None, "success": False, "data": str(e)}

results = []

results.append(("GET /health", test_endpoint("GET", "/health")))
results.append(("POST /chat", test_endpoint("POST", "/chat", {
    "message": "مرحبا كيفك",
    "language": "ar"
})))
results.append(("GET /agents", test_endpoint("GET", "/agents")))
results.append(("POST /knowledge", test_endpoint("POST", "/knowledge", {
    "query": "مرحبا",
    "language": "ar"
})))
results.append(("GET /memory", test_endpoint("GET", "/memory?conversation_id=test123")))
results.append(("GET /settings", test_endpoint("GET", "/settings")))

lines = []
lines.append("=" * 50)
lines.append("TEST RESULTS:")
lines.append("=" * 50)

all_passed = True
for name, result in results:
    status = result.get("status")
    success = result.get("success")
    data = result.get("data")
    
    if success and status == 200:
        status_str = "PASS"
    elif success and status == 401:
        status_str = "AUTH_REQUIRED"
    elif success and status == 404:
        status_str = "NOT_FOUND"
    else:
        status_str = f"FAIL({status})"
    
    lines.append(f"{name}: {status_str}")
    
    if not (success and status == 200):
        all_passed = False
        lines.append(f"  Details: {str(data)[:200]}")

lines.append("=" * 50)
if all_passed:
    lines.append("ALL TESTS PASSED!")
else:
    lines.append("SOME TESTS FAILED")

with open("C:/Users/user/Documents/Default Project/ai-assistant/test_results.txt", "w", encoding="utf-8") as f:
    f.write("\n".join(lines))

print("\n".join(lines))
