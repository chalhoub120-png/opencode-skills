services:
  ollama:
    image: busybox:latest
    container_name: ai-ollama
    command: sleep infinity
    ports:
      - "127.0.0.1:11435:11434"
    volumes:
      - ollama:/root/.ollama
    restart: always
    networks:
      - ai-network

  qdrant:
    image: qdrant/qdrant:latest
    container_name: ai-qdrant
    ports:
      - "127.0.0.1:6333:6333"
    volumes:
      - qdrant:/storage/qdrant
    restart: always
    networks:
      - ai-network

  postgres:
    image: postgres:16
    container_name: ai-postgres
    ports:
      - "127.0.0.1:5432:5432"
    environment:
      POSTGRES_USER: ai
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_DB: ai
    volumes:
      - postgres:/var/lib/postgresql/data
      - ./db/schema.sql:/docker-entrypoint-initdb.d/01-schema.sql
    restart: always
    networks:
      - ai-network

  redis:
    image: redis:7-alpine
    container_name: ai-redis
    ports:
      - "127.0.0.1:6379:6379"
    volumes:
      - redis:/data
    command: ["redis-server", "--appendonly", "yes"]
    restart: always
    networks:
      - ai-network

  n8n:
    image: n8nio/n8n:latest
    container_name: ai-n8n
    ports:
      - "127.0.0.1:5679:5678"
    environment:
      N8N_HOST: n8n
      N8N_PORT: 5678
      N8N_PROTOCOL: http
      N8N_BASIC_AUTH_ACTIVE: "true"
      N8N_BASIC_AUTH_USER: ${N8N_BASIC_AUTH_USER:-admin}
      N8N_BASIC_AUTH_PASSWORD: ${N8N_BASIC_AUTH_PASSWORD}
      N8N_ENCRYPTION_KEY: ${N8N_ENCRYPTION_KEY:-change-this-key-in-production}
      DOC_INGEST_TOKEN: ${DOC_INGEST_TOKEN:-}
      DOC_INGEST_ALLOWED_HOSTS: ${DOC_INGEST_ALLOWED_HOSTS:-}
      DOC_INGEST_CHAT_ID: ${DOC_INGEST_CHAT_ID:-}
    volumes:
      - n8n:/home/node/.n8n
    restart: always
    networks:
      - ai-network
    depends_on:
      - postgres
      - redis

  opencode-orchestrator:
    build:
      context: .
      dockerfile: Dockerfile.orchestrator
    container_name: ai-orchestrator
    ports:
      - "127.0.0.1:8100:8000"
    environment:
      OLLAMA_BASE_URL: http://host.docker.internal:11434
      DIFY_BASE_URL: http://dify:5001
      N8N_BASE_URL: http://n8n:5678
      DATABASE_URL: postgresql+asyncpg://ai:ai123@postgres:5432/ai
      REDIS_URL: redis://redis:6379/0
      QDRANT_URL: http://qdrant:6333
      WHISPER_MODEL: small
      API_SECRET_KEY: ${API_SECRET_KEY:-change-this-key-in-production}
      JWT_SECRET_KEY: ${JWT_SECRET_KEY:-dev-only-jwt-secret-for-local-testing-2026}
      DEFAULT_LLM_MODEL: gemma4:e2b
      REASONING_LLM_MODEL: gemma4:e2b
      LANGUAGE_DETECTION_MODEL: whisper-large-v3
    volumes:
      - ./orchestrator:/app/orchestrator
      - ./agents:/app/agents
      - ./llm:/app/llm
      - ./knowledge:/app/knowledge
      - ./db:/app/db
      - ./tools:/app/tools
      - ./security:/app/security
      - ./voice:/app/voice
      - ./models:/app/models
      - ./scripts:/app/scripts
      - ./dashboard:/app/dashboard
    restart: always
    extra_hosts:
      - "host.docker.internal:host-gateway"
    networks:
      - ai-network
    depends_on:
      - n8n
      - postgres
      - redis
      - qdrant

  dify:
    image: langgenius/dify:latest
    container_name: ai-dify
    ports:
      - "5001:5001"
    environment:
      DATABASE_URL: ${DATABASE_URL}
      REDIS_URL: redis://redis:6379/0
      QDRANT_HOST: qdrant
      QDRANT_PORT: 6333
      OLLAMA_BASE_URL: http://ollama:11434
      SECRET_KEY: ${DIFY_SECRET_KEY:-change-this-key-in-production}
    volumes:
      - dify_storage:/app/storage
    restart: always
    networks:
      - ai-network
    profiles:
      - dify
    depends_on:
      - postgres
      - redis
      - qdrant
      - ollama

volumes:
  ollama:
  qdrant:
  postgres:
  redis:
  n8n:
  dify_storage:

networks:
  ai-network:
    driver: bridge
